# Browser-safe AMap JS credentials
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
# Production: AMap security code stays on the API server.
VITE_AMAP_SERVICE_HOST=
# Leave empty for the local Vite API proxy.
VITE_API_BASE_URL=

# Server-only. Never prefix this with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Production Worker runtime only.
AMAP_KEY=
AMAP_SECURITY_JS_CODE=
ALLOWED_ORIGINS=https://banqiu1230-byte.github.io
